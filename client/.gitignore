# Large served artifacts live outside git (published as the artifact bundle,
# see wasm/KERNEL.md and scripts/fetch-artifacts.sh). Their DIGEST MANIFESTS
# are tracked so any downloaded copy can be verified.
public/runtime/chunks/
public/profiles/*.part-*
public/snapshots/*.snapz
# worker scripts are staged from the qed64 package (scripts/stage-workers.sh)
public/workers/
