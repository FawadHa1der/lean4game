# Large served artifacts live outside git (fetched from the live site by
# scripts/fetch-artifacts.mjs, or built: wasm/KERNEL.md). Their DIGEST MANIFESTS
# are tracked so any copy can be verified.
public/runtime/chunks/
public/profiles/*.part-*
public/snapshots/*.snapz
public/snapshots/*.snapz.partial
