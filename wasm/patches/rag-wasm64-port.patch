 Statement LimZeroTimesBdd (a b c : ℕ → ℝ) (ha : SeqLim a 0) (hb : SeqBdd b) (hc : ∀ n, c n = a n * b n)
       : SeqLim c 0 := by
-intro ε hε
-choose L Lpos hL using hb
-choose N hN using ha (ε / L) (by bound)
-use N
-intro n hn
-rewrite [hc]
-rewrite [(by ring_nf : (a n * b n) - 0 = a n * b n)]
