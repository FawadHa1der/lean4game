diff --git a/Game/CustomTactic/PushNeg.lean b/Game/CustomTactic/PushNeg.lean
new file mode 100644
index 0000000..bd4d732
--- /dev/null
+++ b/Game/CustomTactic/PushNeg.lean
@@ -0,0 +1,17 @@
+import Mathlib.Tactic.Push
+
+/-!
+# `push_neg` without the deprecation warning (wasm64 port)
+
+The Mathlib this build ships (`de3a9cf`, 2026-07) implements `push_neg` as `push Not` and its
+`push_neg` elaborator unconditionally logs "`push_neg` has been deprecated. Prefer using
+`push Not` instead." — a warning a player would see in every level that uses `push_neg`
+(taught in Lecture 12). Mathlib's own deprecation text recommends exactly this macro for
+projects that keep `push_neg`; `priority := high` makes it win over Mathlib's parser so no
+choice node (and no warning) is produced. Behaviour is identical: `push_neg`, `push_neg at h`,
+`push_neg at *`, `push_neg +distrib`.
+-/
+
+open Lean.Parser.Tactic in
+macro (priority := high) "push_neg" cfg:optConfig loc:(location)? : tactic =>
+  `(tactic| push $cfg:optConfig Not $[$loc]?)
